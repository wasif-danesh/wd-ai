# Keep LF line endings on every platform. CRLF breaks shell scripts, Containerfiles and Makefiles
# when a Windows checkout is mounted into WSL or containers.
* text=auto
*.sh text eol=lf
Makefile text eol=lf
Containerfile text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.tpl text eol=lf
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.png binary
*.ico binary
