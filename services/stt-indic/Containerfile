FROM python:3.12-slim
RUN pip install --no-cache-dir torch torchaudio --index-url https://download.pytorch.org/whl/cpu \
    && pip install --no-cache-dir fastapi "uvicorn[standard]" python-multipart numpy \
       "onnxruntime==1.20.1" huggingface_hub
WORKDIR /app
COPY services/stt-indic/server.py .
ENV HF_HOME=/models
EXPOSE 8000
CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8000"]
