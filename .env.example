# Copy to .env (gitignored). Never commit real values.
CONTAINER_ENGINE=podman
DATABASE_URL=postgresql+asyncpg://wd:wd@postgres:5432/wd
REDIS_URL=redis://redis:6379/0
LITELLM_BASE_URL=http://litellm:4000
# Also used as the LiteLLM master key. Generate: echo sk-$(openssl rand -hex 24)
LITELLM_SALT_KEY=change-me
# Encrypts media provider API keys saved in the admin area (ADR-0025). make setup generates one; it
# must be a Fernet key (openssl rand -base64 32 | tr '+/' '-_'). Changing it makes saved keys unreadable.
MEDIA_SECRETS_KEY=change-me
LITELLM_API_KEY=sk-dev-change-me
OLLAMA_BASE_URL=http://host.containers.internal:11434
COMFYUI_BASE_URL=http://host.containers.internal:8188
# The video product runs on its own ComfyUI started with --fp32-unet (ADR-0037); empty = use the one above.
COMFYUI_VIDEO_BASE_URL=
# stub = placeholder images/audio, no ComfyUI or GPU needed. real = drive ComfyUI at COMFYUI_BASE_URL.
COMFYUI_MODE=stub
# Workers sharing one GPU share this id and take turns (one job per GPU).
GPU_ID=gpu0
# Object storage (SeaweedFS locally). Generate the secret: openssl rand -hex 24
STORAGE_ENDPOINT=http://seaweedfs:8333
# Presigned links are signed for this host, which the browser must be able to reach.
STORAGE_PUBLIC_ENDPOINT=http://localhost:8333
STORAGE_BUCKET=wd-ai
STORAGE_ACCESS_KEY=wd-ai
STORAGE_SECRET_KEY=change-me
# Sign-in (ADR-0030). stub = everyone is the dev user (local work, tests). jwt = real sign-in:
# set AUTH_SECRET and API_AUTH_SECRET (openssl rand -hex 32; the API and web must share the second)
# and at least one provider below. Redirect URI per provider: <web origin>/api/auth/callback/<id>
# where <id> is google, github or microsoft-entra-id.
AUTH_MODE=stub
AUTH_SECRET=change-me
API_AUTH_SECRET=change-me-with-at-least-32-characters
AUTH_TRUST_HOST=true
# The address the browser uses. Required: in a container the server listens on 0.0.0.0, and without
# this the OAuth callback address sent to the provider would be http://0.0.0.0:3000/...
AUTH_URL=http://localhost:3000
ADMIN_EMAILS=
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=
# AUTH_MICROSOFT_ENTRA_ID_ID=
# AUTH_MICROSOFT_ENTRA_ID_SECRET=
# AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<tenant id>/v2.0
API_BASE_URL=http://api:8000
LOG_LEVEL=INFO
