# Copy to .env (gitignored). Never commit real values.
CONTAINER_ENGINE=podman
DATABASE_URL=postgresql+asyncpg://wd:wd@postgres:5432/wd
REDIS_URL=redis://redis:6379/0
LITELLM_BASE_URL=http://litellm:4000
# Also used as the LiteLLM master key. Generate: echo sk-$(openssl rand -hex 24)
LITELLM_API_KEY=sk-dev-change-me
OLLAMA_BASE_URL=http://host.containers.internal:11434
COMFYUI_BASE_URL=http://host.containers.internal:8188
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change-me
AUTH_SECRET=change-me
API_BASE_URL=http://api:8000
LOG_LEVEL=INFO
